{
  "name": "@supernova-ai/snh-tool-lsp",
  "description": "Model-facing lsp tool over the SuperNova Harness LSP capability seam (ctx.lsp) \u2014 one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-lsp": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-fs-local": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-lsp": "workspace:*",
    "@supernova-ai/snh-lsp-stdio": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-subprocess-local": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*",
    "@supernova-ai/snh-tool-call-timeout-policy": "workspace:*",
    "@supernova-ai/snh-tool-executor-native": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-working-directory": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*"
  }
