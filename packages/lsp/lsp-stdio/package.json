{
  "name": "@supernova-ai/snh-lsp-stdio",
  "description": "Generic stdio language-server provider for the SuperNova Harness LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-error": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-lsp": "workspace:*",
    "@supernova-ai/snh-subprocess": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-error": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-fs-local": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-lsp": "workspace:*",
    "@supernova-ai/snh-subprocess": "workspace:*",
    "@supernova-ai/snh-subprocess-local": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
