{
  "name": "@supernova-ai/snh-sdk-client",
  "description": "TypeScript client SDK for driving a SuperNova Harness runtime subprocess over stdio JSON-RPC: the SuperNovaHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh": "workspace:*"
  },
  "peerDependencies": {
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-sdk-protocol": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-sdk-protocol": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-experimental-translator": "workspace:*"
  }
}
