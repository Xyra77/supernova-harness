{
  "name": "@supernova-ai/snh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process SuperNova Harness SDK clients",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~"
