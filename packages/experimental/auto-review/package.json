{
  "name": "@supernova-ai/snh-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the SuperNova Harness Auto permission preset",
  "version": "0.2.3-alpha.2",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-instructions": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-permission-presets": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-util-values": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-instructions": "workspace:*",
    "@supernova-ai/snh-agent-loop": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*",
    "@supernova-ai/snh-bash-sandbox": "workspace:*",
    "@supernova-ai/snh-compaction": "workspace:*",
    "@supernova-ai/snh-fs-local": "workspace:*",
    "@supernova-ai/snh-fs-observation-policy": "workspace:*",
    "@supernova-ai/snh-fs-sandbox": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-llm-supernova": "workspace:*",
    "@supernova-ai/snh-llm-supernova-api-key": "workspace:*",
    "@supernova-ai/snh-permission-presets": "workspace:*",
    "@supernova-ai/snh-ptc-runtime-node": "workspace:*",
    "@supernova-ai/snh-sandbox": "workspace:*",
    "@supernova-ai/snh-sandbox-policy": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-shell": "workspace:*",
    "@supernova-ai/snh-shell-env": "workspace:*",
    "@supernova-ai/snh-subagent": "workspace:*",
    "@supernova-ai/snh-subprocess-local": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-tool-bash": "workspace:*",
    "@supernova-ai/snh-tool-executor-native": "workspace:*",
    "@supernova-ai/snh-tool-executor-ptc": "workspace:*",
    "@supernova-ai/snh-tool-fs": "workspace:*",
    "@supernova-ai/snh-tool-subagent": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-user-approval": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-working-directory": "workspace:*",
    "@supernova-ai/snh-supernova-auth": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "snh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
