{
  "name": "@supernova-ai/snh-cua-mcp",
  "description": "Computer Use as an MCP stdio server: a snh profile bundle that exposes cua_run_code to external agent harnesses",
  "version": "0.2.3-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/experimental/cua-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "snh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-attachment": "workspace:*",
    "@supernova-ai/snh-app-boot": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-loop": "workspace:*",
    "@supernova-ai/snh-agent-preset": "workspace:*",
    "@supernova-ai/snh-agent-preset-registry": "workspace:*",
    "@supernova-ai/snh-attachment-local": "workspace:*",
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-cmdline": "workspace:*",
    "@supernova-ai/snh-computer-use": "workspace:*",
    "@supernova-ai/snh-cua": "workspace:*",
    "@supernova-ai/snh-fs-sandbox": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-sandbox-local": "workspace:*",
    "@supernova-ai/snh-sandbox-policy": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-persistence-jsonl": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-storage": "workspace:*",
    "@supernova-ai/snh-storage-domain": "workspace:*",
    "@supernova-ai/snh-storage-json": "workspace:*",
    "@supernova-ai/snh-subprocess-local": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-tool-executor-native": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-user-approval": "workspace:*",
    "@supernova-ai/snh-user-questions": "workspace:*",
    "@supernova-ai/snh-working-directory": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "@modelcontextprotocol/server": "2.2.0",
    "commander": "^15.0.0"
  },
  "optionalDependencies": {
    "@supernova-ai/snh-cua-macos": "workspace:*",
    "@supernova-ai/snh-cua-windows": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-include": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-app-boot": "workspace:*",
    "@supernova-ai/snh-attachment": "workspace:*",
    "@supernova-ai/snh-fs-local": "workspace:*",
    "@supernova-ai/snh-ptc-runtime-node": "workspace:*",
    "@modelcontextprotocol/client": "2.2.0"
  }
}
