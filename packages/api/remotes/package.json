{
  "name": "@supernova-ai/snh-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "snh": {
    "client": {
      "inject": [
        "@supernova-ai/snh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "dependencies": {
    "@supernova-ai/snh-deque": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-scope": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-preset-registry": "workspace:*",
    "@supernova-ai/snh-api-gateway": "workspace:*",
    "@supernova-ai/snh-api-job-controller": "workspace:*",
    "@supernova-ai/snh-api-session-controller": "workspace:*",
    "@supernova-ai/snh-api-settings-controller": "workspace:*",
    "@supernova-ai/snh-api-workspace-controller": "workspace:*",
    "@supernova-ai/snh-api-workspace-files": "workspace:*",
    "@supernova-ai/snh-client-connection": "workspace:*",
    "@supernova-ai/snh-client-file-upload": "workspace:*",
    "@supernova-ai/snh-commands": "workspace:*",
    "@supernova-ai/snh-cordis-host-runner": "workspace:*",
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-file-reference": "workspace:*",
    "@supernova-ai/snh-goal": "workspace:*",
    "@supernova-ai/snh-host-plugin-inventory": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-message-feedback": "workspace:*",
    "@supernova-ai/snh-permission-presets": "workspace:*",
    "@supernova-ai/snh-schedule": "workspace:*",
    "@supernova-ai/snh-scope": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-reference": "workspace:*",
    "@supernova-ai/snh-settings": "workspace:*",
    "@supernova-ai/snh-subagent": "workspace:*",
    "@supernova-ai/snh-typert-protocol": "workspace:*",
    "@supernova-ai/snh-user-approval": "workspace:*",
    "@supernova-ai/snh-user-questions": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "zod": "4.6.6",
    "@supernova-ai/snh-command-feedback": "workspace:*",
    "@supernova-ai/snh-api-terminal-controller": "workspace:*",
    "@supernova-ai/snh-plugin-manager": "workspace:*",
    "@supernova-ai/snh-mcp-manager": "workspace:*",
    "@supernova-ai/snh-plugin-market": "workspace:*",
    "@supernova-ai/snh-client-ui-connector-account": "workspace:*",
    "@supernova-ai/snh-client-ui-plugin-manager": "workspace:*",
    "@supernova-ai/snh-office-kit": "workspace:*",
    "@supernova-ai/snh-deepseek-account": "workspace:*",
    "@supernova-ai/snh-client-product-analytics": "workspace:*",
    "@supernova-ai/snh-client-ui-session-status": "workspace:*",
    "@supernova-ai/snh-agent-team": "workspace:*",
    "@supernova-ai/snh-client-ui-trajectory": "workspace:*",
    "@supernova-ai/snh-web": "workspace:*",
    "@supernova-ai/snh-action-cards": "workspace:*",
    "@supernova-ai/snh-plugin-recommendations": "workspace:*"
  }
}
