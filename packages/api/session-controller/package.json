{
  "name": "@supernova-ai/snh-api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./client/directories": {
      "types": "./lib/types/client/sessions/directories.d.ts",
      "default": "./lib/types/client/sessions/directories.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "snh": {
    "client": {
      "external": [
        "@supernova-ai/snh-api-gateway/client"
      ],
      "inject": [
        "@supernova-ai/snh-api-gateway",
        "@supernova-ai/snh-client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-deque": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-default-model": "workspace:*",
    "@supernova-ai/snh-agent-preset-registry": "workspace:*",
    "@supernova-ai/snh-api-gateway": "workspace:*",
    "@supernova-ai/snh-attachment": "workspace:*",
    "@supernova-ai/snh-client-connection": "workspace:*",
    "@supernova-ai/snh-client-file-upload": "workspace:*",
    "@supernova-ai/snh-commands": "workspace:*",
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-file-reference": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-native-command": "workspace:*",
    "@supernova-ai/snh-scope": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-persistence": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-session-projection-cache": "workspace:*",
    "@supernova-ai/snh-session-query": "workspace:*",
    "@supernova-ai/snh-session-title": "workspace:*",
    "@supernova-ai/snh-settings": "workspace:*",
    "@supernova-ai/snh-skill": "workspace:*",
    "@supernova-ai/snh-subagent": "workspace:*",
    "@supernova-ai/snh-typert-protocol": "workspace:*",
    "@supernova-ai/snh-typert-registry": "workspace:*",
    "@supernova-ai/snh-util-time": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/snh-util-workspace-path": "workspace:*",
    "@supernova-ai/snh-workspace": "workspace:*",
    "@supernova-ai/snh-working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@supernova-ai/snh-session-persistence": {
      "optional": true
    },
    "@supernova-ai/snh-session-projection-cache": {
      "optional": true
    },
    "@supernova-ai/snh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supernova-ai/snh-api-remote-access": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-default-model": "workspace:*",
    "@supernova-ai/snh-agent-loop": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*",
    "@supernova-ai/snh-agent-preset-registry": "workspace:*",
    "@supernova-ai/snh-api-gateway": "workspace:*",
    "@supernova-ai/snh-attachment": "workspace:*",
    "@supernova-ai/snh-attachment-local": "workspace:*",
    "@supernova-ai/snh-client-connection": "workspace:*",
    "@supernova-ai/snh-client-file-upload": "workspace:*",
    "@supernova-ai/snh-client-store": "workspace:*",
    "@supernova-ai/snh-client-test-runtime": "workspace:*",
    "@supernova-ai/snh-commands": "workspace:*",
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-file-reference": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-fs-local": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-native-command": "workspace:*",
    "@supernova-ai/snh-permission-presets": "workspace:*",
    "@supernova-ai/snh-remote-mock": "workspace:*",
    "@supernova-ai/snh-scope": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-persistence": "workspace:*",
    "@supernova-ai/snh-session-persistence-jsonl": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-session-projection-cache": "workspace:*",
    "@supernova-ai/snh-session-query": "workspace:*",
    "@supernova-ai/snh-session-title": "workspace:*",
    "@supernova-ai/snh-settings": "workspace:*",
    "@supernova-ai/snh-skill": "workspace:*",
    "@supernova-ai/snh-storage": "workspace:*",
    "@supernova-ai/snh-storage-domain": "workspace:*",
    "@supernova-ai/snh-storage-json": "workspace:*",
    "@supernova-ai/snh-subagent": "workspace:*",
    "@supernova-ai/snh-typert-protocol": "workspace:*",
    "@supernova-ai/snh-typert-registry": "workspace:*",
    "@supernova-ai/snh-util-crypto": "workspace:*",
    "@supernova-ai/snh-util-time": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/snh-util-workspace-path": "workspace:*",
    "@supernova-ai/snh-workspace": "workspace:*",
    "@types/mime-types": "^3.0.1",
    "@supernova-ai/snh-working-directory": "workspace:*"
  }
}
