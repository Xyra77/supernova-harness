{
  "name": "@supernova-ai/snh-session-query",
  "description": "Combined session query service contract with concrete reads, traces, and filters",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session-query/session-query"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-title": "workspace:*",
    "@supernova-ai/snh-tool-todo": "workspace:*",
    "@supernova-ai/snh-session-persistence": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-session-projection-cache": "workspace:*",
    "@supernova-ai/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@supernova-ai/snh-session-persistence": {
      "optional": true
    },
    "@supernova-ai/snh-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-title": "workspace:*",
    "@supernova-ai/snh-tool-todo": "workspace:*",
    "@supernova-ai/snh-session-persistence": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-session-projection-cache": "workspace:*",
    "@supernova-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@supernova-ai/snh-session-format-catalog": "workspace:*",
    "zod": "4.6.6"
  }
}
