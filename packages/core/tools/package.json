{
  "name": "@supernova-ai/snh-tools",
  "description": "Tool registry and execution pipeline for the SuperNova Harness",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./pipeline": {
      "types": "./lib/types/pipeline.d.ts",
      "default": "./lib/pipeline.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/pipeline.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-scope": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-user-approval": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-scope": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-tool-executor-native": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-user-approval": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*"
  }
}
