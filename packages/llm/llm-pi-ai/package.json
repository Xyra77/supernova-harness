{
  "name": "@supernova-ai/snh-llm-pi-ai",
  "description": "pi-ai-backed SuperNova adapter for the SuperNova Harness LLM seam (design-verification twin of snh-llm-supernova)",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-attachment": "workspace:*",
    "@supernova-ai/snh-authorization": "workspace:*",
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-launch-environment": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*",
    "@supernova-ai/snh-attachment": "workspace:*",
    "@supernova-ai/snh-authorization": "workspace:*",
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-http-proxy": "workspace:*",
    "@supernova-ai/snh-launch-environment": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-llm-supernova": "workspace:*",
    "@supernova-ai/snh-llm-supernova-api-key": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-settings": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-supernova-auth": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@supernova-ai/cordis-plugin-loader": {
      "optional": true
    }
  }
}
