{
  "name": "@supernova-ai/snh-config-editor",
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/config-editor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-hmr": "workspace:*",
    "@supernova-ai/cordis-plugin-include": "workspace:~",
    "@supernova-ai/snh-app-boot": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-atomic-write": "workspace:*",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-hmr": "workspace:*",
    "@supernova-ai/cordis-plugin-include": "workspace:~",
    "@supernova-ai/snh-app-boot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@supernova-ai/snh-hmr": {
      "optional": true
    }
  }
}
