    "@supernova-ai/snh-mcp-resources": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-authorization": "workspace:*",
