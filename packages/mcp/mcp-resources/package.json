{
  "name": "@supernova-ai/snh-mcp-resources",
  "description": "Scoped MCP resource discovery and reading through shared model tools",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/mcp/mcp-resources"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-scope": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-ptc-runtime": "workspace:*",
    "@supernova-ai/snh-scope": "workspace:*",
    "@supernova-ai/snh-tool-executor-native": "workspace:*",
    "@supernova-ai/snh-tool-executor-ptc": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@supernova-ai/snh-system-prompt": {
      "optional": true
    }
  }
}
