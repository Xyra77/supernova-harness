{
  "name": "@supernova-ai/snh-mcp-manager",
  "description": "MCP server manager: a settings-driven fleet of mcp-client instances with runtime status, restart, and probe",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mcp/mcp-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/snh-mcp-client": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-typert-protocol": "workspace:*",
    "@supernova-ai/snh-credentials": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-timeout": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-mcp-client": "workspace:*",
    "@supernova-ai/snh-settings": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-app-boot": "workspace:*",
    "@supernova-ai/snh-config-editor": "workspace:*",
    "@supernova-ai/snh-hmr": "workspace:*",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/cordis-plugin-timer": "workspace:~",
    "@supernova-ai/snh-typert-protocol": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*"
  }
}
