{
  "name": "@supernova-ai/snh-tencent-meeting",
  "description": "Tencent Meeting plugin: the official tmeet with its skill, and account connection from the Plugins page",
  "version": "0.2.3-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/connector/tencent-meeting"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "skills",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "snh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "@tencentcloud/tmeet": "1.0.18"
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-cli-account": "workspace:*",
    "@supernova-ai/snh-upstream-skills": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-cli-account": "workspace:*",
    "@supernova-ai/snh-client-ui-connector-account": "workspace:*",
    "@supernova-ai/snh-skill": "workspace:*",
    "@supernova-ai/snh-subprocess": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-upstream-skills": "workspace:*"
  }
}
