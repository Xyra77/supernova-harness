{
  "name": "@supernova-ai/snh-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@supernova-ai/schemastery": "workspace:~",
    "@supernova-ai/snh-util-ripgrep": "workspace:*"
  },
  "peerDependencies": {
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-output-retention": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-spill": "workspace:*",
    "@supernova-ai/snh-subprocess": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-subprocess": "workspace:*",
    "@supernova-ai/snh-subprocess-local": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-output-retention": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-spill": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*",
    "@supernova-ai/snh-tool-executor-native": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-scope": "workspace:*",
    "@supernova-ai/snh-working-directory": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*",
    "@vscode/ripgrep": "^1.18.0",
    "@supernova-ai/snh-session-projection": "workspace:*"
  }
