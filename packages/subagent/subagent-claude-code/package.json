{
  "name": "@supernova-ai/snh-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "snh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-subagent": "workspace:*",
    "@supernova-ai/snh-subprocess": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "4.6.6",
    "@supernova-ai/snh-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-include": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-app-boot": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-loader-smoke": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-checkpoint-policy": "workspace:*",
    "@supernova-ai/snh-session-persistence-jsonl": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-subagent": "workspace:*",
    "@supernova-ai/snh-subagent-codex": "workspace:*",
    "@supernova-ai/snh-subprocess": "workspace:*",
    "@supernova-ai/snh-subprocess-local": "workspace:*",
    "@supernova-ai/snh-timeout": "workspace:*",
    "@supernova-ai/snh-tool-jobs": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*"
  },
  "icon": "./icon.svg"
}
