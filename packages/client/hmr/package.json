{
  "name": "@supernova-ai/snh-client-hmr",
  "description": "Web client graph and rebuilt-bundle delivery over an authenticated Remote stream",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/hmr"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "snh": {
    "client": {
      "external": [
        "@supernova-ai/snh-api-gateway/client"
      ],
      "inject": [
        "@supernova-ai/snh-api-gateway",
        "@supernova-ai/snh-api-remote-access",
        "@supernova-ai/snh-client-modules"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@supernova-ai/snh-deque": "workspace:*",
    "@supernova-ai/snh-typert-protocol": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-api-gateway": "workspace:*",
    "@supernova-ai/snh-api-remote-access": "workspace:*",
    "@supernova-ai/snh-client-modules": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
