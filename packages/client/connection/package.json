{
  "name": "@supernova-ai/snh-client-connection",
  "description": "Authenticated RPC transport and generation lifecycle",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "node": "./lib/client.node.js",
      "browser": "./lib/client.browser.js",
      "default": "./lib/client.browser.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "snh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.browser.js",
    "lib/client.node.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-scope": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-host-authentication-token": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-attachment": "workspace:*",
    "@supernova-ai/snh-host-webserver": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-scope": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-typert-protocol": "workspace:*",
    "@supernova-ai/snh-client-config": "workspace:*"
  }
}
