{
  "name": "@supernova-ai/snh-client-ui-session-panel",
  "description": "Floating Session panel opened from the Session header, composed of sections that plugins register",
  "version": "0.2.3-alpha.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/client/ui-session-panel"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-api-remotes": "workspace:*",
    "@supernova-ai/snh-api-session-controller": "workspace:*",
    "@supernova-ai/snh-api-workspace-controller": "workspace:*",
    "@supernova-ai/snh-client-connection": "workspace:*",
    "@supernova-ai/snh-client-locale": "workspace:*",
    "@supernova-ai/snh-client-store": "workspace:*",
    "@supernova-ai/snh-client-test-runtime": "workspace:*",
    "@supernova-ai/snh-client-ui-chat": "workspace:*",
    "@supernova-ai/snh-client-ui-context-menu": "workspace:*",
    "@supernova-ai/snh-client-ui-conversation": "workspace:*",
    "@supernova-ai/snh-client-ui-primitives": "workspace:*",
    "@supernova-ai/snh-client-ui-renderer": "workspace:*",
    "@supernova-ai/snh-client-ui-session": "workspace:*",
    "@supernova-ai/snh-client-ui-slots": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-util-workspace-path": "workspace:*",
    "@supernova-ai/snh-working-directory": "workspace:*",
    "@supernova-ai/snh-workspace": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "snh": {
    "client": {
      "inject": [
        "@supernova-ai/snh-api-remotes",
        "@supernova-ai/snh-client-connection",
        "@supernova-ai/snh-client-locale",
        "@supernova-ai/snh-client-ui-chat",
        "@supernova-ai/snh-client-ui-context-menu",
        "@supernova-ai/snh-client-ui-conversation",
        "@supernova-ai/snh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
