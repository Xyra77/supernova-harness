{
  "name": "@supernova-ai/snh-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "snh": {
    "client": {
      "inject": [
        "@supernova-ai/snh-api-workspace-controller",
        "@supernova-ai/snh-client-connection",
        "@supernova-ai/snh-client-locale",
        "@supernova-ai/snh-client-ui-conversation",
        "@supernova-ai/snh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-spill-policy": "workspace:*",
    "@supernova-ai/snh-fs-patch": "workspace:*",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-tool-executor-native": "workspace:*",
    "@supernova-ai/snh-tool-executor-ptc": "workspace:*",
    "@supernova-ai/snh-tool-jobs": "workspace:*",
    "@supernova-ai/snh-tool-session-query": "workspace:*",
    "@supernova-ai/snh-tool-terminal": "workspace:*",
    "@supernova-ai/snh-spill": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-api-remotes": "workspace:*",
    "@supernova-ai/snh-client-connection": "workspace:*",
    "@supernova-ai/snh-client-locale": "workspace:*",
    "@supernova-ai/snh-client-test-runtime": "workspace:*",
    "@supernova-ai/snh-client-ui-conversation": "workspace:*",
    "@supernova-ai/snh-client-ui-primitives": "workspace:*",
    "@supernova-ai/snh-client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@supernova-ai/snh-api-workspace-controller": "workspace:*",
    "@supernova-ai/snh-client-ui-chat": "workspace:*",
    "@supernova-ai/snh-client-ui-renderer": "workspace:*",
    "@supernova-ai/snh-client-ui-session": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/snh-util-workspace-path": "workspace:*",
    "@supernova-ai/snh-attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@supernova-ai/snh-ptc-runtime": "workspace:*",
    "@supernova-ai/snh-token-meter": "workspace:*",
    "@supernova-ai/snh-user-questions": "workspace:*",
    "@supernova-ai/snh-client-ui-context-menu": "workspace:*",
    "@supernova-ai/snh-api-session-controller": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ]
}
