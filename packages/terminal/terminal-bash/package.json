{
  "name": "@supernova-ai/snh-terminal-bash",
  "description": "Persistent shell PTY backend over the SuperNova Harness subprocess terminal primitive",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-terminal": "workspace:*",
    "@supernova-ai/snh-sandbox": "workspace:*",
    "@supernova-ai/snh-sandbox-policy": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-subprocess": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/snh-lazy-require": "workspace:*",
    "@supernova-ai/snh-pwsh-local": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*",
    "@supernova-ai/snh-terminal": "workspace:*",
    "@supernova-ai/snh-sandbox": "workspace:*",
    "@supernova-ai/snh-sandbox-policy": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-subprocess": "workspace:*",
    "@supernova-ai/snh-subprocess-local": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-working-directory": "workspace:*"
  }
}
