{
  "name": "@supernova-ai/snh-web-search-supernova",
  "description": "SuperNova-backed search provider (native web_search via the Anthropic-compatible API) for the SuperNova Harness web capability seam (ctx.web)",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-supernova"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-launch-environment": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-web": "workspace:*",
    "@supernova-ai/snh-supernova-auth": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-credentials": "workspace:*",
    "@supernova-ai/snh-credentials-local": "workspace:*",
    "@supernova-ai/snh-deepseek-account": "workspace:*",
    "@supernova-ai/snh-http-proxy": "workspace:*",
    "@supernova-ai/snh-launch-environment": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-llm-deepseek-account": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-web": "workspace:*",
    "@supernova-ai/snh-supernova-auth": "workspace:*"
  }
}
