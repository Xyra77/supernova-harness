{
  "name": "@supernova-ai/snh-acp",
  "description": "Automation-only Agent Client Protocol server for driving SuperNova Harness agents over JSON-RPC stdio",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-attachment": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-mcp-client": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-persistence": "workspace:*",
    "@supernova-ai/snh-token-meter": "workspace:*",
    "@supernova-ai/snh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@supernova-ai/snh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-loop": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*",
    "@supernova-ai/snh-attachment": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-fs-local": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-mcp-client": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-persistence": "workspace:*",
    "@supernova-ai/snh-session-persistence-jsonl": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-subagent": "workspace:*",
    "@supernova-ai/snh-token-meter": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-user-approval": "workspace:*"
  }
}
