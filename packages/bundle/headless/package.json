{
  "name": "@supernova-ai/snh-headless",
  "description": "The snh one-shot bundle: a direct core Agent/Session runner over snh-base with no Host, HTTP, or browser layer",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "snh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-cmdline": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-default-model": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-query": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-permission-presets": "workspace:*",
    "@supernova-ai/snh-sandbox-policy": "workspace:*",
    "@supernova-ai/snh-subagent": "workspace:*",
    "@supernova-ai/snh-user-approval": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-default-model": "workspace:*",
    "@supernova-ai/snh-agent-loop": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-query": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-permission-presets": "workspace:*",
    "@supernova-ai/snh-sandbox-policy": "workspace:*",
    "@supernova-ai/snh-subagent": "workspace:*",
    "@supernova-ai/snh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@supernova-ai/snh-permission-presets": {
      "optional": true
    },
    "@supernova-ai/snh-sandbox-policy": {
      "optional": true
    },
    "@supernova-ai/snh-subagent": {
      "optional": true
    }
  }
}
