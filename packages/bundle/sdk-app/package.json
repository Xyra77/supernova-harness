{
  "name": "@supernova-ai/snh-sdk-app",
  "description": "The snh SDK profile bundle: stdio JSON-RPC serving and process lifecycle over snh-base",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "snh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@supernova-ai/snh-action-cards": "workspace:*",
    "@supernova-ai/snh-agent-preset": "workspace:*",
    "@supernova-ai/snh-cmdline": "workspace:*",
    "@supernova-ai/snh-creation-recommendations": "workspace:*",
    "@supernova-ai/snh-office-kit": "workspace:*",
    "@supernova-ai/snh-plugin-recommendations": "workspace:*",
    "@supernova-ai/snh-sdk-jsonrpc-server": "workspace:*",
    "@supernova-ai/snh-tool-office": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@supernova-ai/snh-skill-office": "workspace:*",
    "@supernova-ai/snh-tool-workspace-dependencies": "workspace:*",
    "@supernova-ai/snh-client-connection": "workspace:*",
    "@supernova-ai/snh-client-file-upload": "workspace:*",
    "@supernova-ai/snh-workspace": "workspace:*",
    "@supernova-ai/snh-schedule": "workspace:*",
    "@supernova-ai/snh-time-context": "workspace:*",
    "@supernova-ai/snh-tool-schedule": "workspace:*",
    "@supernova-ai/snh-tool-ask-user": "workspace:*",
    "@supernova-ai/snh-tool-present": "workspace:*",
    "@supernova-ai/snh-file-reference-local": "workspace:*",
    "@supernova-ai/snh-deliverable-file-references": "workspace:*"
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/cordis-plugin-include": "workspace:~",
    "@supernova-ai/cordis": "workspace:~"
  }
}
