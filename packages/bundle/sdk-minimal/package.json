{
  "name": "@supernova-ai/snh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one SuperNova adapter, persistent shell, and JSONL sessions",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyra77/supernova-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "snh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@supernova-ai/cordis-plugin-timer": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-agent-loop": "workspace:*",
    "@supernova-ai/snh-attachment-local": "workspace:*",
    "@supernova-ai/snh-compaction-basic": "workspace:*",
    "@supernova-ai/snh-compaction-image-offload": "workspace:*",
    "@supernova-ai/snh-supernova-llm-api-extensions": "workspace:*",
    "@supernova-ai/snh-jobs-local": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-llm-supernova-api-key": "workspace:*",
    "@supernova-ai/snh-llm-retry": "workspace:*",
    "@supernova-ai/snh-mcp-resources": "workspace:*",
    "@supernova-ai/snh-plugin-package-inventory-supernova": "workspace:*",
    "@supernova-ai/snh-sandbox-local": "workspace:*",
    "@supernova-ai/snh-sandbox-policy": "workspace:*",
    "@supernova-ai/snh-sdk-app": "workspace:*",
    "@supernova-ai/snh-sdk-jsonrpc-server": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-checkpoint-policy": "workspace:*",
    "@supernova-ai/snh-session-log-supernova": "workspace:*",
    "@supernova-ai/snh-session-persistence-jsonl": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-session-title": "workspace:*",
    "@supernova-ai/snh-subprocess-local": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-terminal": "workspace:*",
    "@supernova-ai/snh-terminal-bash": "workspace:*",
    "@supernova-ai/snh-token-meter": "workspace:*",
    "@supernova-ai/snh-tool-bash-persistent": "workspace:*",
    "@supernova-ai/snh-tool-executor-native": "workspace:*",
    "@supernova-ai/snh-tool-fs": "workspace:*",
    "@supernova-ai/snh-tool-pwsh-persistent": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-working-directory": "workspace:*",
    "@supernova-ai/snh-fs-local": "workspace:*",
    "@supernova-ai/snh-supernova-auth": "workspace:*"
  },
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/cordis": "workspace:~"
  }
}
