    "@supernova-ai/snh-session-telemetry": "workspace:*",
    "@supernova-ai/snh-subprocess-local": "workspace:*",
    "@supernova-ai/snh-anonymous-user-id": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-http-proxy": "workspace:*",
