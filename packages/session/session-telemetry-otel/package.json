    "@supernova-ai/snh-message-feedback": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-telemetry": "workspace:*",
    "@supernova-ai/snh-anonymous-user-id": "workspace:*",
