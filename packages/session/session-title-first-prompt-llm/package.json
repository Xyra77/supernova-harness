{
  "name": "@supernova-ai/snh-session-title-first-prompt-llm",
  "description": "First-message LLM provider plugin for SuperNova Harness session titles",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-title-first-prompt-llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-title": "workspace:*",
    "@supernova-ai/snh-session-title-llm": "workspace:*",
    "@supernova-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/snh-util-values": "workspace:*",
    "@supernova-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@supernova-ai/cordis-plugin-include": "workspace:~",
    "@supernova-ai/cordis-plugin-loader": "workspace:~",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-llm-supernova": "workspace:*",
    "@supernova-ai/snh-llm-supernova-api-key": "workspace:*",
    "@supernova-ai/snh-llm-pi-ai": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-title": "workspace:*",
    "@supernova-ai/snh-session-title-llm": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-agent-loop": "workspace:*",
    "@supernova-ai/snh-supernova-auth": "workspace:*"
  }
}
