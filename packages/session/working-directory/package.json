{
  "name": "@supernova-ai/snh-working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/working-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-error": "workspace:*"
  },
  "devDependencies": {
    "@supernova-ai/snh-brand": "workspace:*",
    "@supernova-ai/cordis": "workspace:~",
    "@supernova-ai/snh-agent": "workspace:*",
    "@supernova-ai/snh-fs": "workspace:*",
    "@supernova-ai/snh-llm": "workspace:*",
    "@supernova-ai/snh-session": "workspace:*",
    "@supernova-ai/snh-session-projection": "workspace:*",
    "@supernova-ai/snh-system-prompt": "workspace:*",
    "@supernova-ai/snh-agent-loop-testkit": "workspace:*",
    "@supernova-ai/snh-fs-local": "workspace:*",
    "@supernova-ai/snh-error": "workspace:*"
  },
  "dependencies": {
    "@supernova-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  }
}
