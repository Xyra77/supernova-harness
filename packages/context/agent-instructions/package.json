    "@supernova-ai/snh-tool-fs": "workspace:*",
    "@supernova-ai/snh-tool-testkit": "workspace:*",
    "@supernova-ai/snh-tools": "workspace:*",
    "@supernova-ai/snh-working-directory": "workspace:*",
    "@supernova-ai/snh-supernova-auth": "workspace:*"
