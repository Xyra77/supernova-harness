# Copy to production.env in the same machine configuration directory and fill in the values.
SNH_DESKTOP_APP_ID=com.supernova.snh
SNH_DESKTOP_AUTO_UPDATE_ENV=production
SNH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
SNH_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# SNH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
SNH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
SNH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
